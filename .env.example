# === Provider LLM ("gemini" atau "ollama") ===
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# === API Key (isi di file .env lokal, JANGAN commit ke Git) ===
GOOGLE_API_KEY=

# === Ollama (dipakai jika LLM_PROVIDER=ollama) ===
OLLAMA_BASE_URL=http://localhost:11434

# === Embedding ===
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# === Retrieval & Reranker ===
TOP_K=5
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# === Path Data & Vector Store ===
CHUNKS_PATH=data/chunks.jsonl
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=regulasi_uu
